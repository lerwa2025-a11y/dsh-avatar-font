{
  "name": "dsh-avatar-font",
  "version": "2.0.0",
  "description": "头像和字体：给会话双方各配一张头像，消息左右分列（像好友聊天），可导入图片、调大小与圆角、跟随滚动；同时可换界面字体与代码字体、调正文与标题字号、行距、加粗、字色。两个功能各自独立启停。",
  "type": "module",
  "license": "MIT",
  "author": "lerwa",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lerwa2025-a11y/dsh-avatar-font.git"
  },
  "homepage": "https://github.com/lerwa2025-a11y/dsh-avatar-font#readme",
  "bugs": {
    "url": "https://github.com/lerwa2025-a11y/dsh-avatar-font/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "avatar",
    "font",
    "chat-ui"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
